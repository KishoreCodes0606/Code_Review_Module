# ---------------------------------------------------------------------------
# AI Code Review & Security Analysis Agent - environment template
#
# Copy to .env (gitignored) and fill in only what you need.
# NOTHING here is required: with every value blank the platform still runs
# end to end using deterministic components (hashing/BM25 retrieval, template
# remediation, RAG assistant in retrieval_only mode).
#
# Never commit a real key. Placeholders only.
# ---------------------------------------------------------------------------

# --- Optional LLM (remediation prose + conversational answers) --------------
# Both a key and an explicit model are required; a stray key alone cannot
# silently enable the LLM.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=45

# OpenAI-compatible aliases accepted when the LLM_* names are unset.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# --- Optional semantic embeddings for the knowledge base --------------------
# auto (default) = openai when a key+model exist, else the offline hashing
# provider. hashing = offline feature hashing (lexical, not neural).
# openai = OpenAI-compatible /embeddings. sentence-transformers = local model
# when the package is installed.
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_TIMEOUT_SECONDS=30

# Hashing provider only (ignored by the other providers).
EMBEDDING_DIMENSIONS=512

# Local sentence-transformers model (only used when that provider is active).
EMBEDDING_SENTENCE_MODEL=all-MiniLM-L6-v2

# auto | bm25 | vector | hybrid - auto = hybrid when the index is available.
KB_RETRIEVAL_STRATEGY=auto

# --- Static analysis tools --------------------------------------------------
# PMD is downloaded on demand into tools/pmd (gitignored). Set to 1 to work
# fully offline; PMD findings are then reported as unavailable, not as clean.
# PMD_DISABLE_DOWNLOAD=0
# PMD_VERSION=7.9.0
# PMD_TIMEOUT=180
# PMD_DOWNLOAD_TIMEOUT=600

# --- Test-only failure simulation ------------------------------------------
# partial | failed. ENABLES A FAKE AGENT FAILURE and must never be set in a
# real deployment; it is read once at process start and is not reachable over
# HTTP. Leave unset.
# CODE_REVIEW_TEST_FAULTS=
